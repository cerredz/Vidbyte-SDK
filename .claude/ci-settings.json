{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Agent",
      "Bash(python *)",
      "Bash(semgrep *)",
      "Bash(git *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ]
  }
}
